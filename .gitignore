# Environments and caches
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw data. THINGS-EEG2 and the Allen Brain Observatory recordings are distributed
# by their providers under their own terms and are not redistributed here;
# fetch_things_eeg2_test.py and fetch_allen_2p.py fetch them. Their SHA-256
# manifests and fetch logs in data/ are tracked.
data/**/*.npy
data/**/*.part
data/allen_2p/*.nwb
data/allen_2p/ophys_experiments.json

# The paper: the manuscript, its supplement, cover letter, highlights and figures
# with their generators, and the earlier short note. Kept on disk, not published here.
manuscript/
note/
docs/
pilot/
